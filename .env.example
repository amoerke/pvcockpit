# -----------------------------------------------------------------------------
# Vorlage für die Umgebungsvariablen dieses Projekts.
#
# Kopieren nach .env.local und Werte eintragen:
#   cp .env.example .env.local
#
# .env.local wird NICHT committet (siehe .gitignore). Diese Datei hier schon –
# deshalb stehen hier nur Namen und Erklärungen, niemals echte Werte.
# -----------------------------------------------------------------------------

# --- Öffentlich (im Browser sichtbar) ----------------------------------------
# Das Präfix NEXT_PUBLIC_ sorgt dafür, dass Next.js den Wert beim Build fest in
# das JavaScript für den Browser einsetzt. Jeder Besucher kann ihn lesen.
# Das ist hier gewollt: Der Supabase-Client im Browser braucht URL und Anon-Key.

# Basis-URL der Supabase-API (bei self-hosted: die Kong-URL, z. B. https://supabase.example.com)
NEXT_PUBLIC_SUPABASE_URL=

# Der "anon"-Key (JWT mit role=anon). Darf öffentlich sein – was er darf,
# regeln die RLS-Policies in der Datenbank.
# ACHTUNG: Hier niemals den service_role-Key eintragen! Der umgeht RLS komplett.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Nur E2E-Tests (Playwright) ----------------------------------------------
# Eigener Testnutzer (in Supabase Studio mit "Auto Confirm" anlegen).
# Niemals ein echtes Konto verwenden.
# Werte mit Sonderzeichen in "Anführungszeichen" setzen: Ein unquotiertes #
# beginnt einen Kommentar, ein $ verweist auf eine andere Variable.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
